<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Devis {{quote.number}}</title>
<style>
@page { size: A4; margin: 16mm; }
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: "{{style.fontFamily}}", Arial, sans-serif;
  font-size: {{style.fontSize}}pt;
  line-height: 1.55;
  color: {{style.textColor}};
  background: {{style.backgroundColor}};
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18px;
  border-bottom: 1px solid {{style.primaryColor}};
}
.logo { max-width: 150px; max-height: 65px; object-fit: contain; }
.company { text-align: right; font-size: 9pt; color: {{style.secondaryColor}}; }
.company strong { display: block; font-size: 16pt; color: {{style.primaryColor}}; }
.title-row { display: flex; justify-content: space-between; align-items: end; margin: 30px 0 22px; }
h1 { font-size: 28pt; font-weight: 400; margin: 0; color: {{style.primaryColor}}; letter-spacing: 1px; }
.ref { text-align: right; color: {{style.secondaryColor}}; font-size: 10pt; }
.details { display: flex; gap: 25px; margin-bottom: 28px; }
.details section { flex: 1; overflow-wrap: anywhere; }
h2 { font-size: 10pt; letter-spacing: 1px; border-bottom: 1px solid {{style.secondaryColor}}; padding-bottom: 7px; margin: 0 0 10px; color: {{style.primaryColor}}; }
.details p { margin: 3px 0; }
table { width: 100%; border-collapse: collapse; font-size: 9pt; }
thead { display: table-header-group; }
tr { page-break-inside: avoid; }
th { text-align: left; font-weight: 600; padding: 10px 5px; border-bottom: 2px solid {{style.primaryColor}}; }
td { padding: 10px 5px; border-bottom: 1px solid {{style.secondaryColor}}; }
.num { text-align: right; white-space: nowrap; }
.totals { width: 52%; margin: 25px 0 0 auto; }
.totals td { padding: 7px 5px; }
.grand td { border-top: 2px solid {{style.accentColor}}; border-bottom: 2px solid {{style.accentColor}}; font-weight: bold; font-size: 12pt; }
.notes { margin-top: 28px; padding-left: 10px; border-left: 3px solid {{style.accentColor}}; overflow-wrap: anywhere; }
.signature { margin: 40px 0 0 auto; width: 200px; height: 70px; text-align: center; border-top: 1px solid {{style.secondaryColor}}; padding-top: 8px; }
footer { margin-top: 35px; padding-top: 10px; border-top: 1px solid {{style.secondaryColor}}; text-align: center; color: {{style.secondaryColor}}; font-size: 8pt; }
</style>
</head>
<body>
<header>
  {{#if style.showLogo}}
  <img class="logo" src="https://i.ibb.co/vCC87Tky/logo.png" alt="Logo L.I.M.">
  {{/if}}
  <div class="company">
    <strong>L.I.M.</strong>
    Louay Industry &amp; Maintenance<br>
    Travaux industriels et maintenance
  </div>
</header>

<div class="title-row">
  <h1>Devis</h1>
  <div class="ref">
    <strong>{{quote.number}}</strong><br>
    Date : {{quote.issueDate}}
    {{#if quote.validUntil}}<br>Validité : {{quote.validUntil}}{{/if}}
  </div>
</div>

<div class="details">
  <section>
    <h2>CLIENT</h2>
    <p><strong>{{client.companyName}}</strong></p>
    {{#if client.address}}<p>{{client.address}}</p>{{/if}}
    {{#if client.email}}<p>{{client.email}}</p>{{/if}}
    {{#if client.phone}}<p>{{client.phone}}</p>{{/if}}
  </section>
  <section>
    <h2>ÉMETTEUR</h2>
    <p><strong>L.I.M. — Louay Industry &amp; Maintenance</strong></p>
    <p>Travaux industriels et maintenance</p>
  </section>
</div>

{{#if project}}
<section style="margin-bottom:22px">
  <h2>PROJET / CHANTIER</h2>
  <p>{{project.name}}</p>
</section>
{{/if}}

<table>
<thead><tr>
<th>Description</th><th class="num">Quantité</th><th class="num">Prix HT</th><th class="num">TVA</th><th class="num">Total TTC</th>
</tr></thead>
<tbody>
{{#each lines}}
<tr>
<td>{{description}}</td><td class="num">{{quantity}}</td><td class="num">{{unitPrice}} TND</td><td class="num">{{taxRate}} %</td><td class="num">{{total}} TND</td>
</tr>
{{/each}}
</tbody>
</table>

<table class="totals"><tbody>
<tr><td>Total HT</td><td class="num">{{quote.subtotal}} TND</td></tr>
<tr><td>TVA</td><td class="num">{{quote.taxAmount}} TND</td></tr>
<tr class="grand"><td>Total TTC</td><td class="num">{{quote.total}} TND</td></tr>
</tbody></table>

{{#if quote.notes}}<div class="notes"><strong>Notes et conditions</strong><p>{{quote.notes}}</p></div>{{/if}}
{{#if style.showSignature}}<div class="signature">Signature et cachet</div>{{/if}}
{{#if style.showFooter}}<footer>L.I.M. — Louay Industry &amp; Maintenance · Devis {{quote.number}} · {{generatedAt}}</footer>{{/if}}
</body>
</html>