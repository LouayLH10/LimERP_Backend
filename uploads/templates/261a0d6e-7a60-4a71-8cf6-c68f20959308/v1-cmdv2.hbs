
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Commande industrielle {{order.number}}</title>

  <style>
    @page { size: A4; margin: 13mm; }
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "{{style.fontFamily}}", Arial, sans-serif;
      font-size: {{style.fontSize}}pt;
      line-height: 1.45;
      color: #243142;
      background: #ffffff;
    }

    .top-bar {
      height: 8px;
      background: {{style.primaryColor}};
      margin-bottom: 22px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid #d6dde5;
    }

    .logo {
      max-width: 150px;
      max-height: 75px;
      object-fit: contain;
    }

    .company { text-align: right; font-size: 9pt; }
    .company h2 {
      margin: 0;
      color: {{style.primaryColor}};
      font-size: 17pt;
    }

    .company p { margin: 3px 0; }

    .title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin: 24px 0 18px;
    }

    h1 {
      margin: 0;
      color: {{style.primaryColor}};
      font-size: 21pt;
      letter-spacing: 1px;
    }

    .reference {
      text-align: right;
      font-size: 10pt;
    }

    .reference strong {
      display: block;
      font-size: 13pt;
    }

    .section-title {
      color: {{style.primaryColor}};
      font-size: 10pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: .7px;
      margin: 0 0 10px;
      padding-bottom: 6px;
      border-bottom: 2px solid {{style.accentColor}};
    }

    .details {
      display: flex;
      gap: 14px;
      margin-bottom: 22px;
    }

    .panel {
      flex: 1;
      min-width: 0;
      padding: 13px;
      background: #f5f7fa;
      border: 1px solid #e0e5eb;
      border-radius: {{style.borderRadius}}px;
      overflow-wrap: anywhere;
    }

    .panel p { margin: 5px 0; }

    .project-panel {
      margin-bottom: 22px;
      padding: 13px;
      border-left: 4px solid {{style.primaryColor}};
      background: #f5f7fa;
    }

    .project-panel h2 {
      margin: 0 0 8px;
      color: {{style.primaryColor}};
      font-size: 11pt;
    }

    .status {
      display: inline-block;
      padding: 4px 8px;
      border: 1px solid {{style.primaryColor}};
      color: {{style.primaryColor}};
      border-radius: 3px;
      font-size: 8pt;
      font-weight: bold;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
      margin-top: 12px;
    }

    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }

    th {
      background: {{style.primaryColor}};
      color: #ffffff;
      padding: 9px 6px;
      text-align: left;
    }

    td {
      padding: 8px 6px;
      border-bottom: 1px solid #dfe4ea;
      vertical-align: top;
    }

    tbody tr:nth-child(even) { background: #f5f7fa; }

    .number {
      text-align: right;
      white-space: nowrap;
    }

    .totals {
      width: 48%;
      margin-left: auto;
      margin-top: 18px;
    }

    .totals td { padding: 7px 9px; }

    .totals .total-row td {
      background: {{style.primaryColor}};
      color: #ffffff;
      font-size: 11pt;
      font-weight: bold;
    }

    .notes {
      margin-top: 22px;
      padding: 13px;
      border: 1px solid #dfe4ea;
      border-radius: {{style.borderRadius}}px;
    }

    .notes h2 {
      color: {{style.primaryColor}};
      font-size: 10pt;
      margin: 0 0 7px;
    }

    .notes p { margin: 0; overflow-wrap: anywhere; }

    .signature-area {
      display: flex;
      gap: 20px;
      margin-top: 35px;
      page-break-inside: avoid;
    }

    .signature-box {
      flex: 1;
      height: 115px;
      padding: 10px;
      border: 1px solid #cfd6df;
      border-radius: {{style.borderRadius}}px;
    }

    .signature-box h3 {
      margin: 0;
      font-size: 9pt;
      color: {{style.primaryColor}};
    }

    .signature-box p {
      margin-top: 7px;
      font-size: 8pt;
      color: #657386;
    }

    footer {
      margin-top: 24px;
      padding-top: 9px;
      border-top: 1px solid #d6dde5;
      text-align: center;
      color: #657386;
      font-size: 8pt;
    }
  </style>
</head>

<body>
  <div class="top-bar"></div>

  <header>
    
      <img class="logo" src="https://i.ibb.co/vCC87Tky/logo.png" alt="Logo L.I.M.">
    

    <div class="company">
      <h2>L.I.M.</h2>
      <p><strong>Louay Industry &amp; Maintenance</strong></p>
      <p>Travaux industriels et maintenance</p>
      {{#if company.address}}<p>{{company.address}}</p>{{/if}}
      {{#if company.phone}}<p>{{company.phone}}</p>{{/if}}
      {{#if company.email}}<p>{{company.email}}</p>{{/if}}
    </div>
  </header>

  <div class="title-row">
    <h1>BON DE COMMANDE</h1>
    <div class="reference">
      Référence de commande
      <strong>{{order.number}}</strong>
      <span>{{order.orderDate}}</span>
    </div>
  </div>

  <section class="details">
    <div class="panel">
      <h2 class="section-title">Donneur d'ordre / Client</h2>
      <p><strong>{{client.companyName}}</strong></p>
      {{#if client.address}}<p>{{client.address}}</p>{{/if}}
      {{#if client.email}}<p>Email : {{client.email}}</p>{{/if}}
      {{#if client.phone}}<p>Tél. : {{client.phone}}</p>{{/if}}
      {{#if client.taxId}}<p>Matricule fiscal : {{client.taxId}}</p>{{/if}}
    </div>

    <div class="panel">
      <h2 class="section-title">Suivi administratif</h2>
      <p><strong>Commande :</strong> {{order.number}}</p>
      <p><strong>État :</strong> <span class="status">{{order.status}}</span></p>
      {{#if order.quote}}
        <p><strong>Référence devis :</strong> {{order.quote.number}}</p>
      {{/if}}
      <p><strong>Établi le :</strong> {{order.orderDate}}</p>
    </div>
  </section>

  {{#if project}}
    <section class="project-panel">
      <h2>Chantier / Projet concerné</h2>
      <p><strong>{{project.name}}</strong></p>
      {{#if project.address}}<p>Localisation : {{project.address}}</p>{{/if}}
    </section>
  {{/if}}

  <h2 class="section-title">Détail des prestations et fournitures</h2>

  <table>
    <thead>
      <tr>
        <th>Description des travaux</th>
        <th class="number">Qté</th>
        <th class="number">Prix unitaire HT</th>
        <th class="number">TVA</th>
        <th class="number">Total TTC</th>
      </tr>
    </thead>
    <tbody>
      {{#each lines}}
        <tr>
          <td>{{description}}</td>
          <td class="number">{{quantity}}</td>
          <td class="number">{{unitPrice}} TND</td>
          <td class="number">{{taxRate}} %</td>
          <td class="number">{{total}} TND</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <table class="totals">
    <tbody>
      <tr>
        <td>Total HT</td>
        <td class="number">{{order.subtotal}} TND</td>
      </tr>
      <tr>
        <td>Total TVA</td>
        <td class="number">{{order.taxAmount}} TND</td>
      </tr>
      <tr class="total-row">
        <td>Total TTC</td>
        <td class="number">{{order.total}} TND</td>
      </tr>
    </tbody>
  </table>

  {{#if order.notes}}
    <section class="notes">
      <h2>Observations et conditions particulières</h2>
      <p>{{order.notes}}</p>
    </section>
  {{/if}}

  {{#if style.showSignature}}
    <section class="signature-area">
      <div class="signature-box">
        <h3>Pour L.I.M.</h3>
        <p>Nom, signature et cachet</p>
      </div>
      <div class="signature-box">
        <h3>Pour le client</h3>
        <p>Bon pour accord, nom, date et cachet</p>
      </div>
    </section>
  {{/if}}

  {{#if style.showFooter}}
    <footer>
      L.I.M. — Louay Industry &amp; Maintenance
      <p>Document généré par le système ERP L.I.M.</p>
      <p>{{order.number}} — {{generatedAt}}</p>
    </footer>
  {{/if}}
</body>
</html>
