<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Devis {{quote.number}}</title>

  <style>
    @page {
      size: A4;
      margin: 15mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: "{{style.fontFamily}}", Arial, sans-serif;
      font-size: {{style.fontSize}}pt;
      color: {{style.textColor}};
      background: {{style.backgroundColor}};
      margin: 0;
      line-height: 1.5;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      border-bottom: 3px solid {{style.primaryColor}};
      margin-bottom: 25px;
    }

    .logo {
      max-width: 180px;
      max-height: 85px;
      object-fit: contain;
    }

    .company-info {
      text-align: right;
      font-size: 9pt;
      color: {{style.secondaryColor}};
    }

    .company-name {
      font-size: 15pt;
      font-weight: bold;
      color: {{style.primaryColor}};
      margin: 0;
    }

    .document-title {
      text-align: center;
      margin: 25px 0;
      padding: 15px;
      background: {{style.primaryColor}};
      color: #ffffff;
      border-radius: {{style.borderRadius}}px;
    }

    .document-title h1 {
      margin: 0;
      font-size: 23pt;
      letter-spacing: 2px;
    }

    .document-title p {
      margin: 5px 0 0;
      font-size: 10pt;
    }

    .info-section {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .info-box {
      flex: 1;
      padding: 12px;
      border: 1px solid #dddddd;
      border-radius: {{style.borderRadius}}px;
    }

    .info-box h2 {
      font-size: 11pt;
      color: {{style.primaryColor}};
      margin: 0 0 10px;
      padding-bottom: 5px;
      border-bottom: 1px solid #dddddd;
    }

    .info-box p {
      margin: 4px 0;
      overflow-wrap: anywhere;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: {{style.spacing}}px;
      font-size: 9pt;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    th {
      background: {{style.primaryColor}};
      color: #ffffff;
      padding: 10px 7px;
      text-align: left;
    }

    td {
      border-bottom: 1px solid #dddddd;
      padding: 9px 7px;
      vertical-align: top;
    }

    tbody tr:nth-child(even) {
      background: #f8fafc;
    }

    .number {
      text-align: right;
      white-space: nowrap;
    }

    .totals {
      width: 55%;
      margin-left: auto;
      margin-top: 25px;
    }

    .totals td {
      padding: 7px 10px;
    }

    .totals .grand-total td {
      background: {{style.primaryColor}};
      color: #ffffff;
      font-size: 12pt;
      font-weight: bold;
      border: none;
    }

    .notes {
      margin-top: 30px;
      padding: 12px;
      background: #f8fafc;
      border-left: 4px solid {{style.accentColor}};
      overflow-wrap: anywhere;
    }

    .signature {
      margin-top: 45px;
      margin-left: auto;
      width: 220px;
      min-height: 100px;
      text-align: center;
      border-top: 1px solid {{style.secondaryColor}};
      padding-top: 10px;
    }

    footer {
      margin-top: 40px;
      padding-top: 12px;
      border-top: 1px solid #dddddd;
      text-align: center;
      color: {{style.secondaryColor}};
      font-size: 8pt;
    }

    .accent {
      color: {{style.accentColor}};
    }
  </style>
</head>

<body>

  <header>
    
  <img
  class="logo"
  src="https://i.ibb.co/vCC87Tky/logo.png"
  alt="Logo L.I.M."
>
  

    <div class="company-info">
      <p class="company-name">L.I.M.</p>
      <p>Louay Industry &amp; Maintenance</p>
      <p>Travaux industriels et maintenance</p>
    </div>
  </header>

  <section class="document-title">
    <h1>DEVIS</h1>
    <p>Référence : {{quote.number}}</p>
  </section>

  <section class="info-section">
    <div class="info-box">
      <h2>Informations du devis</h2>
      <p><strong>Numéro :</strong> {{quote.number}}</p>
      <p><strong>Date d'émission :</strong> {{quote.issueDate}}</p>
      {{#if quote.validUntil}}
        <p><strong>Valable jusqu'au :</strong> {{quote.validUntil}}</p>
      {{/if}}
    </div>

    <div class="info-box">
      <h2>Client</h2>
      <p><strong>{{client.companyName}}</strong></p>
      {{#if client.address}}
        <p>{{client.address}}</p>
      {{/if}}
      {{#if client.email}}
        <p>{{client.email}}</p>
      {{/if}}
      {{#if client.phone}}
        <p>{{client.phone}}</p>
      {{/if}}
    </div>
  </section>

  {{#if project}}
    <div class="info-box">
      <h2>Projet / Chantier</h2>
      <p>{{project.name}}</p>
    </div>
  {{/if}}

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th class="number">Quantité</th>
        <th class="number">Prix unitaire HT</th>
        <th class="number">TVA (%)</th>
        <th class="number">Total TTC</th>
      </tr>
    </thead>

    <tbody>
      {{#each lines}}
        <tr>
          <td>{{description}}</td>
          <td class="number">{{quantity}}</td>
          <td class="number">{{unitPrice}} TND</td>
          <td class="number">{{taxRate}} %</td>
          <td class="number">{{total}} TND</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <table class="totals">
    <tbody>
      <tr>
        <td>Total HT</td>
        <td class="number">{{quote.subtotal}} TND</td>
      </tr>
      <tr>
        <td>Total TVA</td>
        <td class="number">{{quote.taxAmount}} TND</td>
      </tr>
      <tr class="grand-total">
        <td>TOTAL TTC</td>
        <td class="number">{{quote.total}} TND</td>
      </tr>
    </tbody>
  </table>

  {{#if quote.notes}}
    <div class="notes">
      <strong>Notes et conditions :</strong>
      <p>{{quote.notes}}</p>
    </div>
  {{/if}}

  {{#if style.showSignature}}
    <div class="signature">
      <strong>Signature et cachet</strong>
    </div>
  {{/if}}

  {{#if style.showFooter}}
    <footer>
      <strong>L.I.M. — Louay Industry &amp; Maintenance</strong>
      <p>Document généré automatiquement par le système ERP L.I.M.</p>
      <p>Devis {{quote.number}} — {{generatedAt}}</p>
    </footer>
  {{/if}}

</body>
</html>