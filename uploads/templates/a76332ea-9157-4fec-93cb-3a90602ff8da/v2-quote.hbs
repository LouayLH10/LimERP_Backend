<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Devis {{quote.number}}</title>
<style>
@page { size: A4; margin: 14mm; }
* { box-sizing: border-box; }
body {
  font-family: "{{style.fontFamily}}", Arial, sans-serif;
  font-size: {{style.fontSize}}pt;
  color: {{style.textColor}};
  background: {{style.backgroundColor}};
  margin: 0;
  line-height: 1.5;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18px;
  border-bottom: 3px solid #1e3a8a;
}
.logo { max-width: 170px; max-height: 75px; object-fit: contain; }
.company { text-align: right; color: #64748b; font-size: 9pt; }
.company strong { display: block; color: #1e3a8a; font-size: 17pt; }
h1 { color: #1e3a8a; font-size: 24pt; margin: 25px 0 5px; }
.subtitle { color: #64748b; margin-bottom: 20px; }
.meta {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}
.panel {
  flex: 1;
  border: 1px solid #dbe3ef;
  padding: 12px;
  border-radius: 5px;
  overflow-wrap: anywhere;
}
.panel h2 { color: #1e3a8a; font-size: 11pt; margin: 0 0 8px; }
.panel p { margin: 3px 0; }
table { width: 100%; border-collapse: collapse; font-size: 9pt; }
thead { display: table-header-group; }
tr { page-break-inside: avoid; }
th { background: #1e3a8a; color: white; padding: 10px 7px; text-align: left; }
td { padding: 9px 7px; border-bottom: 1px solid #e2e8f0; }
tbody tr:nth-child(even) { background: #f1f5f9; }
.num { text-align: right; white-space: nowrap; }
.totals { width: 55%; margin: 22px 0 0 auto; }
.totals td { padding: 8px; }
.grand td { background: #1e3a8a; color: white; font-size: 12pt; font-weight: bold; }
.notes { margin-top: 25px; padding: 12px; background: #f1f5f9; border-left: 4px solid #e7820d; overflow-wrap: anywhere; }
.signature { margin: 40px 0 0 auto; width: 210px; height: 80px; text-align: center; border-top: 1px solid #94a3b8; padding-top: 8px; }
footer { margin-top: 30px; border-top: 1px solid #cbd5e1; padding-top: 10px; text-align: center; font-size: 8pt; color: #64748b; }
</style>
</head>
<body>
<header>
  <img class="logo" src="file:///D:/lim/site%20web/erp/backend/erp-backend/src/logo/logo.png" alt="Logo L.I.M.">
  <div class="company">
    <strong>L.I.M.</strong>
    Louay Industry &amp; Maintenance
    <br>Travaux industriels et maintenance
  </div>
</header>

<h1>DEVIS</h1>
<div class="subtitle">Référence {{quote.number}}</div>

<div class="meta">
  <div class="panel">
    <h2>Informations du devis</h2>
    <p><strong>Numéro :</strong> {{quote.number}}</p>
    <p><strong>Date :</strong> {{quote.issueDate}}</p>
    {{#if quote.validUntil}}<p><strong>Validité :</strong> {{quote.validUntil}}</p>{{/if}}
  </div>
  <div class="panel">
    <h2>Client</h2>
    <p><strong>{{client.companyName}}</strong></p>
    {{#if client.address}}<p>{{client.address}}</p>{{/if}}
    {{#if client.email}}<p>{{client.email}}</p>{{/if}}
    {{#if client.phone}}<p>{{client.phone}}</p>{{/if}}
  </div>
</div>

{{#if project}}
<div class="panel" style="margin-bottom:20px">
  <h2>Projet / Chantier</h2>
  <p>{{project.name}}</p>
</div>
{{/if}}

<table>
<thead>
<tr>
  <th>Description</th>
  <th class="num">Qté</th>
  <th class="num">Prix unitaire HT</th>
  <th class="num">TVA</th>
  <th class="num">Total TTC</th>
</tr>
</thead>
<tbody>
{{#each lines}}
<tr>
  <td>{{description}}</td>
  <td class="num">{{quantity}}</td>
  <td class="num">{{unitPrice}} TND</td>
  <td class="num">{{taxRate}} %</td>
  <td class="num">{{total}} TND</td>
</tr>
{{/each}}
</tbody>
</table>

<table class="totals">
<tbody>
<tr><td>Total HT</td><td class="num">{{quote.subtotal}} TND</td></tr>
<tr><td>Total TVA</td><td class="num">{{quote.taxAmount}} TND</td></tr>
<tr class="grand"><td>TOTAL TTC</td><td class="num">{{quote.total}} TND</td></tr>
</tbody>
</table>

{{#if quote.notes}}
<div class="notes"><strong>Notes et conditions</strong><p>{{quote.notes}}</p></div>
{{/if}}

{{#if style.showSignature}}
<div class="signature">Signature et cachet</div>
{{/if}}

{{#if style.showFooter}}
<footer>
<strong>L.I.M. — Louay Industry &amp; Maintenance</strong><br>
Devis {{quote.number}} · Généré le {{generatedAt}}
</footer>
{{/if}}
</body>
</html>